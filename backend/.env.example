# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Path to the SQLite database file (relative to the backend/ directory)
DB_PATH=fitness.db

# HS256 signing secret for JWTs — use a long random string in any real deployment
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-before-use

# Token lifetime in hours (default: 24)
JWT_EXPIRE_HOURS=24

# Canonical business timezone — must remain Asia/Kolkata per SRS §2.3
TIMEZONE=Asia/Kolkata
